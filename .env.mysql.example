# Copy to .env.mysql locally; deploy.py uses this file by default.
COMPOSE_FILE=compose.yaml:compose.mysql.yaml
# Build RUN steps use the remote Linux host network; runtime ports are unchanged.
# Set default if host networking is unavailable or bridge DNS has been fixed.
BUILD_NETWORK=host
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=filamentdb
MYSQL_USER=filamentdb
# Local file: keep .env.mysql and .env private (chmod 600); never commit them.
MYSQL_PASSWORD='ERSTAT_MED_LANG_TILFAELDIG_ADGANGSKODE'
